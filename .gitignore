/target
/unixlib/target

# Generated by .cargo/lld-link-winegcc on each link.
/.cargo/wine-msvc-libs/
/.cargo/wine-shims/*.obj

# Local toolchain overrides (WINE_MSVC_LIB_DIR).
/.env

# Working notes and launch helpers kept out of version control. build-release.sh is the
# exception: it is the supported way to build the DLL (a plain `cargo build` produces a file
# that will not load), so the README cannot reference it unless it ships.
/PLAN.md
/scripts/*
!/scripts/build-release.sh
